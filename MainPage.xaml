<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MlbbHelper.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#07101F">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050B18" Offset="0" />
                <GradientStop Color="#0A1B39" Offset="0.52" />
                <GradientStop Color="#061022" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse WidthRequest="280" HeightRequest="280" InputTransparent="True"
                 HorizontalOptions="Start" VerticalOptions="Start"
                 TranslationX="-150" TranslationY="-110" Fill="#263E91FF" />
        <Ellipse WidthRequest="330" HeightRequest="330" InputTransparent="True"
                 HorizontalOptions="End" VerticalOptions="End"
                 TranslationX="170" TranslationY="170" Fill="#1B00C8FF" />

        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="18,18,18,0" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                    <Label Text="MLBB Помощник" FontSize="27" FontAttributes="Bold"
                           TextColor="#EDF7FF" />
                    <Label x:Name="PatchLabel" Text="Загрузка справочника…" FontSize="13"
                           TextColor="#90C9F2" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="i" Clicked="OnAboutTapped"
                        WidthRequest="42" HeightRequest="42" Padding="0"
                        CornerRadius="21" FontSize="17" FontAttributes="Bold"
                        TextColor="#D8F2FF" BackgroundColor="#25325370"
                        BorderColor="#6C9BC8E8" BorderWidth="1"
                        VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Glass}" HeightRequest="54" Padding="15,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="⌕" FontSize="25" TextColor="#8CCEFF" VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry" Grid.Column="1"
                           Placeholder="Введите имя героя"
                           PlaceholderColor="#89A9CB"
                           TextColor="#EDF7FF"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="WhileEditing"
                           ReturnType="Search"
                           TextChanged="OnSearchChanged" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="StatusLabel" Text="Данные доступны и без подключения к сети"
                       FontSize="11" TextColor="#89ADD3" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" MaxLines="1" />
                <Label x:Name="CountLabel" Grid.Column="1" Text=""
                       FontSize="11" TextColor="#A7D8FF" VerticalOptions="Center" />
            </Grid>

            <RefreshView x:Name="Refresh" Grid.Row="3" Refreshing="OnRefreshing"
                         RefreshColor="#54C7FF">
                <CollectionView x:Name="HeroList" SelectionMode="None"
                                Margin="-4,0,-4,18">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3"
                                         VerticalItemSpacing="10" HorizontalItemSpacing="7" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,48,20,0">
                            <Label Text="Герой не найден" FontSize="18" FontAttributes="Bold"
                                   TextColor="#D9EEFF" HorizontalTextAlignment="Center" />
                            <Label Text="Проверьте написание имени или попробуйте поискать по английскому названию."
                                   FontSize="13" TextColor="#94B4D6"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="3">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHeroTapped" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border Stroke="#5577B9EF" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 19"
                                        BackgroundColor="#C8122038" Padding="0">
                                    <Border.Shadow>
                                        <Shadow Brush="#3855BFFF" Radius="13" Opacity="0.54" Offset="0,0" />
                                    </Border.Shadow>
                                    <Grid RowDefinitions="122,Auto">
                                        <Grid>
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                                    BackgroundColor="#172D50">
                                                <Image Source="{Binding Portrait}" Aspect="AspectFill" />
                                            </Border>
                                            <Border VerticalOptions="End" Padding="6,4"
                                                    BackgroundColor="#D8071227" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10" Margin="5,0,5,5">
                                                <Label Text="{Binding RoleDisplay}" FontSize="9"
                                                       TextColor="#C9E9FF" LineBreakMode="TailTruncation"
                                                       MaxLines="1" HorizontalTextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <VerticalStackLayout Grid.Row="1" Padding="7,7,7,9" Spacing="3">
                                            <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                                                   TextColor="#F1F8FF" LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Text="{Binding LaneDisplay}" FontSize="9"
                                                   TextColor="#9ABBE0" LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
