                    </LinearGradientBrush>
                </Setter>
                <Setter Property="Background">
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A6FB8FF" Offset="0" />
                        <GradientStop Color="#1A1A3A8F" Offset="1" />
                    </LinearGradientBrush>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
